{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easyeda.hardware-lifecycle.module-profile.v1",
  "title": "Pluggable hardware lifecycle module profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "moduleId",
    "version",
    "stages",
    "inputs",
    "outputs",
    "acceptanceRules",
    "invalidationTriggers",
    "adapters",
    "maximumRisk"
  ],
  "properties": {
    "schemaVersion": { "const": "easyeda.hardware-lifecycle.module-profile.v1" },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["concept", "module_design", "schematic_review", "bom_selection", "bom_writeback"]
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "acceptanceRules": { "type": "array", "items": { "type": "string" } },
    "invalidationTriggers": { "type": "array", "items": { "type": "string" } },
    "adapters": { "type": "array", "items": { "type": "string" } },
    "maximumRisk": { "enum": ["READ", "EPHEMERAL_WRITE", "PERSISTENT_WRITE"] }
  }
}
