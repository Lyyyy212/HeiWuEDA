{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easyeda.hardware-lifecycle.api-plan.v1",
  "title": "Validated EasyEDA API operation plan",
  "type": "object",
  "required": ["schemaVersion", "planId", "risk", "registry", "identity", "calls", "save", "planDigest"],
  "properties": {
    "schemaVersion": { "const": "easyeda.hardware-lifecycle.api-plan.v1" },
    "planId": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["READ", "EPHEMERAL_WRITE", "PERSISTENT_WRITE"] },
    "registry": {
      "type": "object",
      "required": ["schemaVersion", "package", "version", "declarationSha256"],
      "properties": {
        "schemaVersion": { "const": "easyeda.api-manifest.v1" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "declarationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["projectUuid", "documentUuid", "documentType", "capturedAt", "bridgeService", "windowId", "gatewayVersion", "bridgeScriptSha256"],
      "properties": {
        "projectUuid": { "type": ["string", "null"] },
        "documentUuid": { "type": ["string", "null"] },
        "documentType": { "type": ["string", "number", "null"] },
        "capturedAt": { "type": "string", "format": "date-time" },
        "bridgeService": { "const": "easyeda-bridge" },
        "windowId": { "type": ["string", "null"] },
        "gatewayVersion": { "type": "string", "minLength": 1 },
        "bridgeScriptSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["methodId", "effect", "purpose", "args", "resultKey"],
        "properties": {
          "methodId": { "type": "string", "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+#[1-9][0-9]*$" },
          "effect": { "enum": ["READ", "WRITE"] },
          "purpose": { "type": "string", "minLength": 1 },
          "args": { "type": "array" },
          "resultKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "pick": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
          },
          "effectReview": {
            "type": "object",
            "required": ["classification", "reviewer", "rationale"],
            "properties": {
              "classification": { "enum": ["READ", "WRITE"] },
              "reviewer": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "save": { "type": "boolean" },
    "rollback": {
      "type": "object",
      "required": ["strategy", "verification"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["allowedFields", "pageUuid"],
      "properties": {
        "allowedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["Manufacturer", "Manufacturer Part", "Supplier", "Supplier Part"] }
        },
        "pageUuid": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "risk": { "const": "READ" } } },
      "then": { "properties": { "save": { "const": false } } }
    },
    {
      "if": { "properties": { "risk": { "const": "EPHEMERAL_WRITE" } } },
      "then": { "required": ["rollback", "scope"], "properties": { "save": { "const": false } } }
    },
    {
      "if": { "properties": { "risk": { "const": "PERSISTENT_WRITE" } } },
      "then": { "required": ["scope"], "properties": { "save": { "const": true } } }
    }
  ]
}
