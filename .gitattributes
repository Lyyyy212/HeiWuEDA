* text=auto

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.d.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
