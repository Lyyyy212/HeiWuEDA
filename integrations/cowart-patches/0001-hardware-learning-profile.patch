diff --git a/scripts/probe-hardware-learning.mjs b/scripts/probe-hardware-learning.mjs
new file mode 100644
index 0000000..b070776
--- /dev/null
+++ b/scripts/probe-hardware-learning.mjs
@@ -0,0 +1,47 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+
+import { createCowartAnalytics } from "../src/analytics.js";
+import {
+  HARDWARE_LEARNING_MODE,
+  currentCowartWidgetProfile,
+} from "../src/learning/hardwareLearningProfile.js";
+
+const windowObject = {
+  openai: {
+    toolOutput: { mode: HARDWARE_LEARNING_MODE, analyticsEnabled: true },
+    callTool() {
+      throw new Error("analytics MCP must not be called in hardware-learning mode");
+    },
+  },
+  localStorage: {
+    getItem() {
+      throw new Error("analytics client ID must not be read in hardware-learning mode");
+    },
+  },
+};
+let appended = 0;
+const documentObject = {
+  head: { append() { appended += 1; } },
+  createElement() { return {}; },
+  getElementById() { return null; },
+};
+
+const profile = currentCowartWidgetProfile(windowObject);
+assert.equal(profile.hardwareLearning, true);
+assert.equal(profile.analyticsEnabled, false);
+assert.equal(createCowartAnalytics({ windowObject, documentObject }).trackCanvasOpened(), false);
+assert.equal(appended, 0);
+
+const appSource = await readFile(new URL("../src/App.jsx", import.meta.url), "utf8");
+assert.match(appSource, /!hardwareLearning && <CowartToolbarItem toolId=\{AI_IMAGE_TOOL_ID\}/);
+assert.match(appSource, /!hardwareLearning && <CowartAiDraftGenerationPanel \/>/);
+assert.match(appSource, /!isHardwareLearningMode\(\) && !isInCropTool/);
+
+const serverSource = await readFile(new URL("../mcp/server.mjs", import.meta.url), "utf8");
+assert.match(serverSource, /mode: widgetModeSchema\.optional\(\)/);
+assert.match(serverSource, /assertLearningGenerationAllowed\(args, "HTML"\)/);
+assert.match(serverSource, /LEARNING_EVIDENCE_SOURCES\.has\(args\.evidenceSource\)/);
+
+console.log("Cowart hardware-learning profile probe passed.");
+
