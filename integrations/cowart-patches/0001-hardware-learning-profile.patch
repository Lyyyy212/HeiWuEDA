diff --git a/src/learning/hardwareLearningProfile.js b/src/learning/hardwareLearningProfile.js
new file mode 100644
index 0000000..0e34b9e
--- /dev/null
+++ b/src/learning/hardwareLearningProfile.js
@@ -0,0 +1,22 @@
+export const HARDWARE_LEARNING_MODE = 'hardware-learning'
+
+export function currentCowartWidgetProfile(windowObject = globalThis.window) {
+  const payload = windowObject?.openai?.toolOutput && typeof windowObject.openai.toolOutput === 'object'
+    ? windowObject.openai.toolOutput
+    : {}
+  const mode = payload.mode === HARDWARE_LEARNING_MODE ? HARDWARE_LEARNING_MODE : 'default'
+  return {
+    mode,
+    hardwareLearning: mode === HARDWARE_LEARNING_MODE,
+    analyticsEnabled: mode === HARDWARE_LEARNING_MODE ? false : payload.analyticsEnabled !== false
+  }
+}
+
+export function isHardwareLearningMode(windowObject = globalThis.window) {
+  return currentCowartWidgetProfile(windowObject).hardwareLearning
+}
+
+export function isCowartAnalyticsEnabled(windowObject = globalThis.window) {
+  return currentCowartWidgetProfile(windowObject).analyticsEnabled
+}
+
