+async function beginChunkedCowartDownload(args = {}) {
+  const expectedBytes = Number(args.expectedBytes);
+  if (!Number.isInteger(expectedBytes) || expectedBytes <= 0 || expectedBytes > MAX_CHUNKED_DOWNLOAD_BYTES) {
+    throw new Error(`Chunked Cowart download expectedBytes must be between 1 and ${MAX_CHUNKED_DOWNLOAD_BYTES}.`);
+  }
+
+  const downloadsDir = join(homedir(), "Downloads");
+  const requestedName = sanitizeFileName(nonEmptyString(args.fileName), `cowart-download-${Date.now()}.bin`);
+  const requestedDirectoryName = nonEmptyString(args.directoryName);
+  const requestedSubdirectory = nonEmptyString(args.subdirectory);
+  let directoryName = requestedDirectoryName ? sanitizeDirectoryName(requestedDirectoryName) : null;
+  let exportRoot = directoryName ? join(downloadsDir, directoryName) : downloadsDir;
+  if (directoryName && args.uniqueDirectory === true) {
+    const uniqueDirectory = await uniqueDirectoryPath(downloadsDir, directoryName);
+    directoryName = uniqueDirectory.directoryName;
+    exportRoot = uniqueDirectory.directoryPath;
+  }
+  const targetDir = requestedSubdirectory
+    ? join(exportRoot, sanitizeDirectoryName(requestedSubdirectory, "pages"))
+    : exportRoot;
+  if (!isSafeChildPath(downloadsDir, targetDir) && targetDir !== downloadsDir) {
+    throw new Error("Invalid Cowart download directory.");
+  }
+  await mkdir(targetDir, { recursive: true });
+  const { fileName, filePath } = args.overwrite === true
+    ? { fileName: requestedName, filePath: join(targetDir, requestedName) }
+    : await uniqueFilePath(targetDir, requestedName);
+  const temporaryDir = await mkdtemp(join(tmpdir(), "cowart-download-"));
+  const temporaryPath = join(temporaryDir, "payload.part");
+  await writeFile(temporaryPath, Buffer.alloc(0));
+  const downloadId = randomUUID();
+  activeCowartDownloads.set(downloadId, {
+    downloadId,
+    directoryName,
+    directoryPath: exportRoot,
+    expectedBytes,
+    fileName,
+    filePath,
+    mimeType: nonEmptyString(args.mimeType) || "application/octet-stream",
+    nextChunkIndex: 0,
+    overwrite: args.overwrite === true,
+    receivedBytes: 0,
+    temporaryDir,
+    temporaryPath,
+  });
+  return { ok: true, action: "begin", downloadId, expectedBytes, fileName, mimeType: nonEmptyString(args.mimeType) || "application/octet-stream" };
+}
+
+function activeCowartDownload(args = {}) {
+  const downloadId = nonEmptyString(args.downloadId);
+  const download = downloadId ? activeCowartDownloads.get(downloadId) : null;
+  if (!download) throw new Error("Cowart chunked download session was not found or has expired.");
+  return download;
+}
+
+async function appendChunkedCowartDownload(args = {}) {
+  const download = activeCowartDownload(args);
+  const chunkIndex = Number(args.chunkIndex);
+  if (!Number.isInteger(chunkIndex) || chunkIndex !== download.nextChunkIndex) {
+    throw new Error(`Cowart download expected chunk ${download.nextChunkIndex}, received ${args.chunkIndex}.`);
+  }
+  const chunkBase64 = nonEmptyString(args.chunkBase64);
+  if (!chunkBase64) throw new Error("Cowart download chunkBase64 is required.");
+  const chunk = Buffer.from(chunkBase64, "base64");
+  if (!chunk.length || chunk.length > MAX_DOWNLOAD_CHUNK_BYTES) {
+    throw new Error(`Cowart download chunks must contain between 1 and ${MAX_DOWNLOAD_CHUNK_BYTES} bytes.`);
+  }
+  if (download.receivedBytes + chunk.length > download.expectedBytes) {
+    throw new Error("Cowart download received more bytes than expected.");
+  }
+  await appendFile(download.temporaryPath, chunk);
+  download.receivedBytes += chunk.length;
+  download.nextChunkIndex += 1;
+  return {
+    ok: true,
+    action: "append",
+    downloadId: download.downloadId,
+    chunkIndex,
+    receivedBytes: download.receivedBytes,
+    expectedBytes: download.expectedBytes,
+  };
+}
+
+async function cancelChunkedCowartDownload(args = {}) {
+  const download = activeCowartDownload(args);
+  activeCowartDownloads.delete(download.downloadId);
+  await rm(download.temporaryDir, { recursive: true, force: true });
+  return { ok: true, action: "cancel", downloadId: download.downloadId };
+}
+
+async function finishChunkedCowartDownload(args = {}) {
+  const download = activeCowartDownload(args);
+  if (download.receivedBytes !== download.expectedBytes) {
+    throw new Error(`Cowart download is incomplete: ${download.receivedBytes} of ${download.expectedBytes} bytes.`);
+  }
+  if (download.overwrite) await rm(download.filePath, { force: true });
+  await rename(download.temporaryPath, download.filePath);
+  activeCowartDownloads.delete(download.downloadId);
+  await rm(download.temporaryDir, { recursive: true, force: true });
+  return {
+    ok: true,
+    action: "finish",
+    downloadId: download.downloadId,
+    fileName: download.fileName,
+    filePath: download.filePath,
+    directoryName: download.directoryName,
+    directoryPath: download.directoryPath,
+    mimeType: download.mimeType,
+    fileSize: download.receivedBytes,
+  };
+}
+
+async function downloadCowartFile(args = {}) {
+  if (args.action === "begin") return beginChunkedCowartDownload(args);
+  if (args.action === "append") return appendChunkedCowartDownload(args);
+  if (args.action === "finish") return finishChunkedCowartDownload(args);
+  if (args.action === "cancel") return cancelChunkedCowartDownload(args);
+  return downloadCowartFileDirect(args);
+}
