diff --git a/src/learning-canvas/interaction.js b/src/learning-canvas/interaction.js
index e642e89..15777fa 100644
--- a/src/learning-canvas/interaction.js
+++ b/src/learning-canvas/interaction.js
@@ -12,6 +12,28 @@ export function isSpaceKey(event) {
   return event?.code === 'Space' || event?.key === ' ' || event?.key === 'Spacebar'
 }
 
+export function learningTextEditMode(shape) {
+  const mode = shape?.meta?.cowartLearningKind
+  return ['text', 'note'].includes(mode) ? mode : null
+}
+
+export function learningTextEditState(shape) {
+  const mode = learningTextEditMode(shape)
+  if (!mode || typeof shape?.id !== 'string') return null
+  return {
+    point: { x: Number(shape.x) || 0, y: Number(shape.y) || 0 },
+    text: String(shape.meta?.cowartLearningText || ''),
+    shapeId: shape.id,
+    mode
+  }
+}
+
+export function shouldBeginTextEditFromActivation(shape, { eventType = 'click', detail = 0 } = {}) {
+  if (!learningTextEditMode(shape)) return false
+  if (eventType === 'dblclick') return true
+  return eventType === 'click' && Number(detail) >= 2
+}
+
 export function selectionForShapePointerDown(selectedIds, shapeId, { shiftKey = false } = {}) {
   const current = Array.isArray(selectedIds) ? selectedIds : []
   if (shiftKey) {
diff --git a/src/learning-canvas/interaction.test.mjs b/src/learning-canvas/interaction.test.mjs
index 7c69a13..9d56081 100644
--- a/src/learning-canvas/interaction.test.mjs
+++ b/src/learning-canvas/interaction.test.mjs
@@ -5,8 +5,11 @@ import {
   cameraAfterWheel,
   canMoveCanvasShape,
   escapeAction,
+  learningTextEditMode,
+  learningTextEditState,
   nudgeDeltaForKey,
   selectionForShapePointerDown,
+  shouldBeginTextEditFromActivation,
   translateCanvasSelection
 } from './interaction.js'
 
@@ -35,6 +38,23 @@ test('shape pointer selection retains an existing multi-selection for dragging',
   assert.deepEqual(selectionForShapePointerDown(['shape:a'], 'shape:a', { shiftKey: true }), [])
 })
 
+test('text and sticky notes enter editing on a double activation only', () => {
+  const text = { type: 'geo', meta: { cowartLearningKind: 'text', cowartLearningText: '测试1' } }
+  const note = { type: 'geo', meta: { cowartLearningKind: 'note', cowartLearningText: '便签1' } }
+  const frame = { type: 'geo', meta: { cowartLearningFrame: true, cowartLearningKind: 'frame' } }
+
+  assert.equal(learningTextEditMode(text), 'text')
+  assert.equal(learningTextEditMode(note), 'note')
+  assert.deepEqual(
+    learningTextEditState({ id: 'shape:text', x: 12, y: 34, ...text }),
+    { point: { x: 12, y: 34 }, text: '测试1', shapeId: 'shape:text', mode: 'text' }
+  )
+  assert.equal(shouldBeginTextEditFromActivation(text, { eventType: 'click', detail: 1 }), false)
+  assert.equal(shouldBeginTextEditFromActivation(text, { eventType: 'click', detail: 2 }), true)
+  assert.equal(shouldBeginTextEditFromActivation(note, { eventType: 'dblclick', detail: 0 }), true)
+  assert.equal(shouldBeginTextEditFromActivation(frame, { eventType: 'click', detail: 2 }), false)
+})
+
 test('multi-selection movement preserves locked schematic evidence', () => {
   const initial = snapshot()
   assert.equal(canMoveCanvasShape(initial.store['shape:image-unlocked']), true)
