@@ -0,0 +1,83 @@
+import { useState } from 'react'
+import { useEditor } from 'tldraw'
+
+import { saveCowartLearningQuestion } from '../cowartClient.js'
+import { captureLearningSelection } from './captureLearningSelection.js'
+import { sendHardwareLearningQuestion } from './learningMessage.js'
+
+function inferIntent(question) {
+  if (/比较|对比|compare|\bvs\b/i.test(question)) return 'compare-options'
+  if (/电源|供电|power|supply|rail/i.test(question)) return 'power-path'
+  if (/信号|网络|走向|trace|signal|net/i.test(question)) return 'trace-signal'
+  if (/器件|芯片|电阻|电容|component|part/i.test(question)) return 'explain-component'
+  if (/检查|风险|review|risk/i.test(question)) return 'review-concept'
+  return 'explain-selection'
+}
+
+export function HardwareQuestionPanel() {
+  const editor = useEditor()
+  const [questionText, setQuestionText] = useState('')
+  const [level, setLevel] = useState('intermediate')
+  const [status, setStatus] = useState('idle')
+
+  async function submit() {
+    if (!questionText.trim() || status === 'saving') return
+    setStatus('saving')
+    try {
+      const captured = await captureLearningSelection(editor)
+      const now = new Date().toISOString()
+      const question = {
+        schemaVersion: 'learning.question.v1',
+        questionId: `question:${crypto.randomUUID()}`,
+        sessionId: `learning:cowart:${editor.getCurrentPageId().replace(/^page:/, '')}`,
+        intent: inferIntent(questionText),
+        userQuestion: questionText.trim(),
+        learningLevel: level,
+        selection: captured.selection,
+        easyedaContext: {
+          mode: 'offline-artifact',
+          projectUuid: null,
+          documentUuid: null,
+          documentType: null,
+          schematicPageUuid: null,
+          windowId: null,
+          capturedAt: now,
+          artifactSha256: captured.selection.selectionScreenshotSha256
+        },
+        requestedAt: now
+      }
+      await saveCowartLearningQuestion({ question, screenshotDataUrl: captured.screenshotDataUrl })
+      await sendHardwareLearningQuestion(question)
+      setQuestionText('')
+      setStatus('sent')
+    } catch (error) {
+      console.error(error)
+      setStatus('error')
+    }
+  }
+
+  return (
+    <section className="cowart-hardware-question-panel" aria-label="硬件学习提问">
+      <strong>硬件学习</strong>
+      <textarea
+        aria-label="硬件问题"
+        onChange={(event) => setQuestionText(event.target.value)}
+        placeholder="选中原理图区域后提问…"
+        value={questionText}
+      />
+      <div>
+        <select aria-label="学习层级" onChange={(event) => setLevel(event.target.value)} value={level}>
+          <option value="beginner">入门</option>
+          <option value="intermediate">进阶</option>
+          <option value="advanced">高级</option>
+        </select>
+        <button disabled={!questionText.trim() || status === 'saving'} onClick={submit} type="button">
+          {status === 'saving' ? '保存中…' : '解析选区'}
+        </button>
+      </div>
+      {status === 'error' && <small>提交失败，请检查当前选区和本地桥。</small>}
+      {status === 'sent' && <small>问题已保存并发送。</small>}
+    </section>
+  )
+}
+
diff --git a/src/learning/captureLearningSelection.js b/src/learning/captureLearningSelection.js
new file mode 100644
index 0000000..fe87ffc
--- /dev/null
+++ b/src/learning/captureLearningSelection.js
@@ -0,0 +1,88 @@
+async function sha256Text(value) {
+  const bytes = new TextEncoder().encode(value)
+  const digest = await crypto.subtle.digest('SHA-256', bytes)
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+async function sha256DataUrl(dataUrl) {
+  const encoded = String(dataUrl).split(',', 2)[1] || ''
+  const binary = atob(encoded)
+  const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0))
+  const digest = await crypto.subtle.digest('SHA-256', bytes)
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+function roleForShape(shape) {
+  if (shape.type === 'image') return 'source-image'
+  if (shape.meta?.cowartHardwareAnnotation === true) return 'selection-frame'
+  if (shape.type === 'note' || shape.type === 'text') return 'question-note'
+  if (['arrow', 'highlight', 'geo', 'draw'].includes(shape.type)) return 'annotation'
+  return 'other'
+}
+
+function unionBounds(bounds) {
+  const x = Math.min(...bounds.map((item) => item.x))
+  const y = Math.min(...bounds.map((item) => item.y))
+  const right = Math.max(...bounds.map((item) => item.x + item.width))
+  const bottom = Math.max(...bounds.map((item) => item.y + item.height))
+  return { x, y, width: right - x, height: bottom - y, rotation: 0, coordinateSpace: 'cowart-page' }
+}
+
+export async function captureLearningSelection(editor) {
+  const shapeIds = editor.getSelectedShapeIds()
+  if (shapeIds.length === 0) throw new Error('请先选择原理图图片或标注区域。')
+  const shapes = shapeIds.map((shapeId) => {
+    const shape = editor.getShape(shapeId)
+    const bounds = editor.getShapePageBounds(shapeId)
+    if (!shape || !bounds) throw new Error(`无法读取选中 shape：${shapeId}`)
+    const asset = shape.props?.assetId ? editor.getAsset(shape.props.assetId) : null
+    return {
+      shapeId,
+      shapeType: shape.type,
+      role: roleForShape(shape),
+      pageBounds: {
+        x: bounds.x,
+        y: bounds.y,
+        width: bounds.width,
+        height: bounds.height,
+        rotation: shape.rotation || 0,
+        coordinateSpace: 'cowart-page'
+      },
+      parentShapeId: shape.parentId || null,
+      assetUrl: asset?.props?.src || null,
+      text: shape.props?.text || shape.props?.richText?.content?.[0]?.content?.[0]?.text || null,
+      meta: shape.meta || {}
+    }
+  })
+  if (!shapes.some((shape) => ['source-image', 'selection-frame', 'question-note'].includes(shape.role))) {
+    throw new Error('选区必须包含原理图图片、框选区域或问题便签。')
+  }
+  if (shapes.filter((shape) => shape.role === 'source-image').length > 4) {
+    throw new Error('一次硬件问题最多引用四张图片。')
+  }
+  const image = await editor.toImageDataUrl(shapeIds, {
+    background: true,
+    darkMode: false,
+    format: 'png',
+    padding: 12
+  })
+  const capturedAt = new Date().toISOString()
+  const selectionCore = {
+    version: 1,
+    cowartPageId: editor.getCurrentPageId(),
+    selectedShapeIds: shapeIds,
+    shapes,
+    unionBounds: unionBounds(shapes.map((shape) => shape.pageBounds)),
+    capturedAt
+  }
+  return {
+    selection: {
+      ...selectionCore,
+      selectionScreenshotAssetUrl: null,
+      selectionScreenshotSha256: await sha256DataUrl(image.url),
+      canvasSnapshotSha256: await sha256Text(JSON.stringify(selectionCore))
+    },
+    screenshotDataUrl: image.url
+  }
+}
+
