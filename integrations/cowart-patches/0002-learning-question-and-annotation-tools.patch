--- /dev/null
+++ b/src/learning/learningAnnotations.js
@@ -0,0 +1,81 @@
+import { createShapeId, toRichText } from 'tldraw'
+
+import {
+  acknowledgeCowartLearningAnnotations,
+  pullCowartLearningAnnotations
+} from '../cowartClient.js'
+
+const ALLOWED_KINDS = new Set(['note', 'highlight', 'rectangle', 'arrow'])
+
+function shapeForCommand(command) {
+  if (!ALLOWED_KINDS.has(command.kind)) throw new Error(`不允许的学习标注：${command.kind}`)
+  const bounds = command.bounds || { x: 0, y: 0, width: 320, height: 160 }
+  const base = {
+    id: createShapeId(),
+    x: bounds.x,
+    y: bounds.y,
+    meta: {
+      cowartLearningOperationId: command.operationId,
+      cowartLearningCommandId: command.commandId,
+      cowartLearningKind: command.kind
+    }
+  }
+  if (command.kind === 'note') {
+    return { ...base, type: 'note', props: { richText: toRichText(command.text || ''), color: 'blue' } }
+  }
+  if (command.kind === 'arrow') {
+    return { ...base, type: 'arrow', props: { start: { x: 0, y: 0 }, end: { x: bounds.width, y: bounds.height }, color: 'blue' } }
+  }
+  return {
+    ...base,
+    type: 'geo',
+    opacity: command.kind === 'highlight' ? 0.35 : 1,
+    props: {
+      geo: 'rectangle',
+      w: bounds.width,
+      h: bounds.height,
+      color: command.style?.color || 'blue',
+      fill: command.kind === 'highlight' ? 'semi' : 'none',
+      dash: command.style?.dash || 'solid',
+      richText: toRichText(command.text || '')
+    }
+  }
+}
+
+function alreadyApplied(editor, command) {
+  return Array.from(editor.getCurrentPageShapeIds()).some((shapeId) => {
+    const shape = editor.getShape(shapeId)
+    return shape?.meta?.cowartLearningOperationId === command.operationId &&
+      shape?.meta?.cowartLearningCommandId === command.commandId
+  })
+}
+
+export async function applyPendingLearningAnnotations(editor) {
+  const pageId = editor.getCurrentPageId()
+  const pulled = await pullCowartLearningAnnotations(pageId)
+  for (const operation of pulled.operations || []) {
+    const commands = operation.commands || []
+    const missing = commands.filter((command) => !alreadyApplied(editor, command))
+    if (missing.length > 0) editor.createShapes(missing.map(shapeForCommand))
+    await acknowledgeCowartLearningAnnotations(operation.operationId, operation.commandsSha256)
+  }
+}
+
+export function startLearningAnnotationPolling(editor) {
+  let running = false
+  async function poll() {
+    if (running) return
+    running = true
+    try {
+      await applyPendingLearningAnnotations(editor)
+    } catch (error) {
+      console.error(error)
+    } finally {
+      running = false
+    }
+  }
+  poll()
+  const timer = window.setInterval(poll, 1500)
+  return () => window.clearInterval(timer)
+}
+
