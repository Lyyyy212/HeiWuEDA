diff --git a/src/cowartClient.test.mjs b/src/cowartClient.test.mjs
index eae04e1..51a9be9 100644
--- a/src/cowartClient.test.mjs
+++ b/src/cowartClient.test.mjs
@@ -23,12 +23,14 @@ test('large Cowart widget exports use ordered chunked Bridge calls', async () =>
     const dataBase64 = 'QUJD'.repeat(200_000)
     const result = await downloadCowartFile({
       dataBase64,
+      directoryName: 'Cowart学习画板',
       fileName: 'fixture.png',
       mimeType: 'image/png',
       onProgress: (event) => progress.push(event)
     })
     assert.equal(result.ok, true)
     assert.equal(calls[0].arguments.action, 'begin')
+    assert.equal(calls[0].arguments.directoryName, 'Cowart学习画板')
     assert.equal(calls.at(-1).arguments.action, 'finish')
     const appendCalls = calls.filter((call) => call.arguments.action === 'append')
     assert.ok(appendCalls.length > 1)
