From cadde5aea6057c3ab2a03e5f89eb9139bd272646 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 24 Aug 2026 18:03:00 +0800
Subject: [PATCH] fix: use native EasyEDA PNG for learning canvas

---
 scripts/probe-hardware-learning.mjs    | 18 +++----
 scripts/probe-learning-tools.mjs       | 13 +++--
 src/learning/HardwareQuestionPanel.jsx | 74 ++++----------------------
 src/learning/learningMessage.js        | 28 +++-------
 4 files changed, 29 insertions(+), 104 deletions(-)

diff --git a/scripts/probe-hardware-learning.mjs b/scripts/probe-hardware-learning.mjs
index f43a9dd..5dbff21 100644
--- a/scripts/probe-hardware-learning.mjs
+++ b/scripts/probe-hardware-learning.mjs
@@ -44,21 +44,19 @@ const questionPanelSource = await readFile(
 );
 assert.match(questionPanelSource, /onPointerDown=\{stopCanvasInteraction\}/);
 assert.match(questionPanelSource, /onClick=\{stopCanvasInteraction\}/);
-assert.match(questionPanelSource, /autoImportedEditors/);
-assert.match(questionPanelSource, /同步当前原理图页/);
-assert.match(questionPanelSource, /导入当前工程全部原理图/);
-assert.match(questionPanelSource, /sendCurrentSchematicPageImport/);
-assert.match(questionPanelSource, /sendCurrentProjectSchematicImport/);
+assert.match(questionPanelSource, /导入官方原理图 PNG/);
+assert.match(questionPanelSource, /sendNativeSchematicVisualImport/);
+assert.doesNotMatch(questionPanelSource, /autoImportedEditors|导入当前工程全部原理图/);
 
 const learningMessageSource = await readFile(
   new URL("../src/learning/learningMessage.js", import.meta.url),
   "utf8",
 );
-assert.match(learningMessageSource, /intent: import-current-easyeda-schematic-page/);
-assert.match(learningMessageSource, /schematic-source-render --render-png/);
-assert.match(learningMessageSource, /intent: import-current-easyeda-project-schematics/);
-assert.match(learningMessageSource, /schematic-project-source-render/);
-assert.match(learningMessageSource, /禁止调用会卡住页面的 current-page 视觉导出/);
+assert.match(learningMessageSource, /intent: import-easyeda-native-schematic-visual/);
+assert.match(learningMessageSource, /schematic-export --format PNG --scope current-schematic/);
+assert.match(learningMessageSource, /learning-native-visual-import-manifest/);
+assert.match(learningMessageSource, /禁止 EPRO 图像渲染/);
+assert.doesNotMatch(learningMessageSource, /schematic-source-render|schematic-project-source-render/);
 assert.doesNotMatch(learningMessageSource, /getExportDocumentFile|imagegen/);
 
 const stylesSource = await readFile(new URL("../src/styles.css", import.meta.url), "utf8");
diff --git a/scripts/probe-learning-tools.mjs b/scripts/probe-learning-tools.mjs
index 63619f6..3f9c1b9 100644
--- a/scripts/probe-learning-tools.mjs
+++ b/scripts/probe-learning-tools.mjs
@@ -58,16 +58,15 @@ try {
 
   const panelSource = await readFile(new URL("../src/learning/HardwareQuestionPanel.jsx", import.meta.url), "utf8");
   assert.match(panelSource, /captureLearningSelection/);
-  assert.match(panelSource, /sendCurrentSchematicPageImport/);
-  assert.match(panelSource, /autoImportedEditors/);
-  assert.match(panelSource, /同步当前原理图页/);
-  assert.match(panelSource, /导入当前工程全部原理图/);
+  assert.match(panelSource, /sendNativeSchematicVisualImport/);
+  assert.match(panelSource, /导入官方原理图 PNG/);
+  assert.doesNotMatch(panelSource, /autoImportedEditors|导入当前工程全部原理图/);
   assert.doesNotMatch(panelSource, /imagegen|insert_cowart_image|insert_cowart_html_draft/);
   const messageSource = await readFile(new URL("../src/learning/learningMessage.js", import.meta.url), "utf8");
   assert.match(messageSource, /official-easyeda-export/);
-  assert.match(messageSource, /learning-page-import-manifest/);
-  assert.match(messageSource, /import-current-easyeda-project-schematics/);
-  assert.match(messageSource, /learning-project-import-manifest/);
+  assert.match(messageSource, /learning-native-visual-import-manifest/);
+  assert.match(messageSource, /import-easyeda-native-schematic-visual/);
+  assert.doesNotMatch(messageSource, /learning-page-import-manifest|learning-project-import-manifest/);
   assert.doesNotMatch(messageSource, /getExportDocumentFile|eda\.|imagegen/);
   const annotationSource = await readFile(new URL("../src/learning/learningAnnotations.js", import.meta.url), "utf8");
   assert.match(annotationSource, /cowartLearningOperationId/);
diff --git a/src/learning/HardwareQuestionPanel.jsx b/src/learning/HardwareQuestionPanel.jsx
index 84cd366..5662726 100644
--- a/src/learning/HardwareQuestionPanel.jsx
+++ b/src/learning/HardwareQuestionPanel.jsx
@@ -1,16 +1,13 @@
-import { useEffect, useState } from 'react'
+import { useState } from 'react'
 import { useEditor } from 'tldraw'
 
