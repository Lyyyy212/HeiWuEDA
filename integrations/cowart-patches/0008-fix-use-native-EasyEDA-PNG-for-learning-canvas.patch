-      {projectImportStatus === 'sent' && <small>已发送全工程只读导入请求。</small>}
+      {importStatus === 'sent' && <small>已发送官方 PNG 只读导入请求。</small>}
       <textarea
         aria-label="硬件问题"
         onChange={(event) => setQuestionText(event.target.value)}
diff --git a/src/learning/learningMessage.js b/src/learning/learningMessage.js
index e27df9b..e17d4f4 100644
--- a/src/learning/learningMessage.js
+++ b/src/learning/learningMessage.js
@@ -21,31 +21,15 @@ export async function sendHardwareLearningQuestion(question) {
   return sender({ prompt, content: [{ type: 'text', text: prompt }] })
 }
 
-export async function sendCurrentSchematicPageImport({ cowartPageId, trigger = 'manual-sync' }) {
+export async function sendNativeSchematicVisualImport({ cowartPageId }) {
   const sender = resolveSender()
   const prompt = [
-    '请使用 EasyEDA hardware lifecycle skill 的学习画板导入流程，把当前 EasyEDA 原理图页导入这个已有 Cowart 页面。',
-    'intent: import-current-easyeda-schematic-page',
+    '请使用 EasyEDA hardware lifecycle skill 的原生视觉导入流程，把官方 EasyEDA 原理图 PNG 导入这个已有 Cowart 页面。',
+    'intent: import-easyeda-native-schematic-visual',
     `cowartPageId: ${cowartPageId}`,
-    `trigger: ${trigger}`,
-    '必须先后校验同一个 projectUuid、documentUuid、documentType=1；只通过官方只读 schematic-source-export 导出 EPRO。',
-    '使用本地 schematic-source-render --render-png 按当前 documentUuid 选择并渲染 PNG，再生成 learning-page-import-manifest。',
-    '仅按清单调用 hardware-learning Cowart 的 official-easyeda-export 图片入口并写入同一 cowartPageId；保留源与渲染证据路径和 SHA-256。',
-    '禁止调用会卡住页面的 current-page 视觉导出，禁止切页、保存或写入 EasyEDA，禁止生图、改图、AI HTML 或 Slides。'
-  ].join('\n')
-  return sender({ prompt, content: [{ type: 'text', text: prompt }] })
-}
-
-export async function sendCurrentProjectSchematicImport({ cowartPageId }) {
-  const sender = resolveSender()
-  const prompt = [
-    '请使用 EasyEDA hardware lifecycle skill 的学习画板工程导入流程，把当前 EasyEDA 工程的全部原理图页导入这个已有 Cowart 页面。',
-    'intent: import-current-easyeda-project-schematics',
-    `cowartPageId: ${cowartPageId}`,
-    '必须先后校验同一个 projectUuid、documentUuid、documentType=1；只通过官方只读 schematic-project-source-export 导出一次项目 EPRO。',
-    '使用本地 schematic-project-source-render 从项目 EPRO 枚举并逐页渲染 PNG，再生成 learning-project-import-manifest。',
-    '按清单顺序去重插入同一 cowartPageId；保留工程源、每页渲染证据路径和 SHA-256，已存在的同页同摘要证据必须跳过。',
-    '禁止切换 EasyEDA 页面、保存或写入 EasyEDA，禁止调用 current-page 视觉导出，禁止生图、改图、AI HTML 或 Slides。'
+    '必须先后校验同一个 projectUuid、documentUuid、documentType=1；只通过官方只读 schematic-export --format PNG --scope current-schematic 导出原生 PNG。',
+    '使用 learning-native-visual-import-manifest 校验官方导出证据，再按清单通过 official-easyeda-export 图片入口写入同一 cowartPageId；保留 PNG、证据路径和 SHA-256。',
+    'Current Schematic 产物不得冒充精确当前图页。禁止 EPRO 图像渲染、全部图页渲染、current-page 视觉导出、切页、保存或写入 EasyEDA，禁止生图、改图、AI HTML 或 Slides。'
   ].join('\n')
   return sender({ prompt, content: [{ type: 'text', text: prompt }] })
 }
