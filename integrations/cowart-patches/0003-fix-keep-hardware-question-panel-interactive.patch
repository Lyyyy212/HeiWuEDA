From 58be4864ae3b9a194f8b36703602b85383a69753 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 24 Aug 2026 14:29:27 +0800
Subject: [PATCH] fix: keep hardware question panel interactive

---
 scripts/probe-hardware-learning.mjs    | 14 +++++++++++++-
 src/learning/HardwareQuestionPanel.jsx | 14 ++++++++++++--
 src/styles.css                         |  1 +
 3 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/scripts/probe-hardware-learning.mjs b/scripts/probe-hardware-learning.mjs
index b070776..139f553 100644
--- a/scripts/probe-hardware-learning.mjs
+++ b/scripts/probe-hardware-learning.mjs
@@ -38,10 +38,22 @@ assert.match(appSource, /!hardwareLearning && <CowartToolbarItem toolId=\{AI_IMA
 assert.match(appSource, /!hardwareLearning && <CowartAiDraftGenerationPanel \/>/);
 assert.match(appSource, /!isHardwareLearningMode\(\) && !isInCropTool/);
 
+const questionPanelSource = await readFile(
+  new URL("../src/learning/HardwareQuestionPanel.jsx", import.meta.url),
+  "utf8",
+);
+assert.match(questionPanelSource, /onPointerDown=\{stopCanvasInteraction\}/);
+assert.match(questionPanelSource, /onClick=\{stopCanvasInteraction\}/);
+
+const stylesSource = await readFile(new URL("../src/styles.css", import.meta.url), "utf8");
+assert.match(
+  stylesSource,
+  /\.cowart-hardware-question-panel\s*\{[\s\S]*?pointer-events:\s*auto;/,
+);
+
 const serverSource = await readFile(new URL("../mcp/server.mjs", import.meta.url), "utf8");
 assert.match(serverSource, /mode: widgetModeSchema\.optional\(\)/);
 assert.match(serverSource, /assertLearningGenerationAllowed\(args, "HTML"\)/);
 assert.match(serverSource, /LEARNING_EVIDENCE_SOURCES\.has\(args\.evidenceSource\)/);
 
 console.log("Cowart hardware-learning profile probe passed.");
-
diff --git a/src/learning/HardwareQuestionPanel.jsx b/src/learning/HardwareQuestionPanel.jsx
index 9c73ba3..291bb92 100644
--- a/src/learning/HardwareQuestionPanel.jsx
+++ b/src/learning/HardwareQuestionPanel.jsx
@@ -14,6 +14,10 @@ function inferIntent(question) {
   return 'explain-selection'
 }
 
+function stopCanvasInteraction(event) {
+  event.stopPropagation()
+}
+
 export function HardwareQuestionPanel() {
   const editor = useEditor()
   const [questionText, setQuestionText] = useState('')
@@ -57,7 +61,14 @@ export function HardwareQuestionPanel() {
   }
 
   return (
-    <section className="cowart-hardware-question-panel" aria-label="硬件学习提问">
+    <section
+      className="cowart-hardware-question-panel"
+      aria-label="硬件学习提问"
+      onClick={stopCanvasInteraction}
+      onPointerDown={stopCanvasInteraction}
+      onPointerUp={stopCanvasInteraction}
+      onWheel={stopCanvasInteraction}
+    >
       <strong>硬件学习</strong>
       <textarea
         aria-label="硬件问题"
@@ -80,4 +91,3 @@ export function HardwareQuestionPanel() {
     </section>
   )
 }
-
diff --git a/src/styles.css b/src/styles.css
index c1777f8..5f1b8ba 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -1182,6 +1182,7 @@ body {
   right: 18px;
   bottom: 18px;
   z-index: 500;
+  pointer-events: auto;
   display: grid;
   width: min(380px, calc(100vw - 36px));
   gap: 8px;
-- 
2.55.0.windows.3

