+  ZoomOut
+} from 'lucide-react'
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
+
+import {
+  acknowledgeCowartLearningAnnotations,
+  copyCowartImageToClipboard,
+  downloadCowartFile,
+  loadCowartCanvasState,
+  pullCowartLearningAnnotations,
+  readCowartPageAsset,
+  refreshCowartCanvasSnapshot,
+  saveCowartCanvasSnapshot,
+  saveCowartSelectionState,
+  saveCowartViewState
+} from '../cowartClient.js'
+import { applyLearningAnnotationOperations } from './annotations.js'
+import {
+  addShape,
+  createArrowShape,
+  createFrameShape,
+  createNoteShape,
+  createStrokeShape,
+  deleteLearningShapes,
+  fitCamera,
+  migrateLegacyLearningFrames,
+  normalizeBounds,
+  pageBoundsForShape,
+  pageRecords,
+  resizeRectangleShape,
+  screenToPage,
+  selectionState,
+  shapesForPage,
+  translateShape,
+  unionBounds,
+  updateShape,
+  zoomCameraAt
+} from './model.js'
+import {
+  buildLearningCanvasSvg,
+  colorValue,
+  svgDataUrl,
+  svgToPngDataUrl,
+  textToBase64
+} from './export.js'
+import './styles.css'
+
+const TOOLS = [
+  { id: 'select', label: '选择', Icon: MousePointer2 },
+  { id: 'hand', label: '平移', Icon: Hand },
+  { id: 'frame', label: '学习框', Icon: BoxSelect },
+  { id: 'pen', label: '画笔', Icon: Brush },
+  { id: 'highlight', label: '高亮', Icon: Highlighter },
+  { id: 'arrow', label: '箭头', Icon: ArrowUpRight },
+  { id: 'note', label: '文字', Icon: StickyNote }
+]
+
+const DEFAULT_CAMERA = { x: 0, y: 0, z: 1 }
+const EMPTY_VIEW_STATE = { version: 1, currentPageId: null, camera: DEFAULT_CAMERA }
+
+function snapshotSignature(snapshot) {
+  return JSON.stringify(snapshot?.store ?? {})
+}
+
+function assetDataUrl(asset) {
+  return `data:${asset.mimeType};base64,${asset.dataBase64}`
+}
+
+function pointerPosition(event, root) {
+  const rect = root.getBoundingClientRect()
+  return { x: event.clientX - rect.left, y: event.clientY - rect.top }
+}
+
+function noteTextLines(text) {
+  const lines = []
+  for (const source of String(text || '').split(/\r?\n/)) {
+    if (!source) lines.push('')
+    for (let index = 0; index < source.length; index += 26) lines.push(source.slice(index, index + 26))
+  }
+  return lines.slice(0, 10)
+}
+
+function LearningShape({ shape, snapshot, assetSources, selected, onPointerDown, onDoubleClick }) {
+  const common = {
+    'data-shape-id': shape.id,
+    onDoubleClick: (event) => onDoubleClick(event, shape),
+    onPointerDown: (event) => onPointerDown(event, shape),
+    style: { cursor: 'inherit' },
+    transform: `translate(${shape.x || 0} ${shape.y || 0}) rotate(${((shape.rotation || 0) * 180) / Math.PI})`
+  }
+  if (shape.type === 'image') {
+    const asset = snapshot.store[shape.props?.assetId]
+    const source = assetSources.get(asset?.props?.src) || asset?.props?.src || ''
+    return (
+      <image
+        {...common}
+        className={selected ? 'is-selected' : ''}
+        height={shape.props?.h || 1}
+        href={source}
+        preserveAspectRatio="none"
+        width={shape.props?.w || 1}
+      />
+    )
+  }
+  if (shape.type === 'arrow') {
+    const start = shape.props?.start ?? { x: 0, y: 0 }
+    const end = shape.props?.end ?? { x: 1, y: 1 }
+    return (
+      <line
+        {...common}
+        className={selected ? 'is-selected' : ''}
+        markerEnd="url(#learning-arrow)"
+        stroke={colorValue(shape.props?.color, '#2563eb')}
+        strokeLinecap="round"
+        strokeWidth={3 / Math.max(0.2, 1)}
+        x1={start.x}
+        x2={end.x}
+        y1={start.y}
+        y2={end.y}
+      />
+    )
+  }
+  if (shape.type === 'draw' || shape.type === 'highlight') {
+    const points = (shape.meta?.cowartLearningPoints ?? []).map((point) => `${point.x},${point.y}`).join(' ')
+    return (
+      <polyline
+        {...common}
+        className={selected ? 'is-selected' : ''}
+        fill="none"
+        points={points}
+        stroke={shape.type === 'highlight' ? '#facc15' : colorValue(shape.props?.color)}
+        strokeLinecap="round"
+        strokeLinejoin="round"
+        strokeOpacity={shape.type === 'highlight' ? 0.5 : 1}
+        strokeWidth={shape.type === 'highlight' ? 18 : 4}
