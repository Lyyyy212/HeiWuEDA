+.learning-canvas-shell {
+  --learning-blue: #2563eb;
+  --learning-ink: #18212f;
+  --learning-panel: rgb(255 255 255 / 94%);
+  position: fixed;
+  inset: 0;
+  display: grid;
+  grid-template-rows: 58px 1fr;
+  overflow: hidden;
+  color: var(--learning-ink);
+  background: #edf2f7;
+  user-select: none;
+}
+
+.learning-topbar {
+  z-index: 20;
+  display: flex;
+  padding: 0 18px;
+  align-items: center;
+  justify-content: space-between;
+  background: var(--learning-panel);
+  border-bottom: 1px solid #d8e0ea;
+  box-shadow: 0 1px 8px rgb(15 23 42 / 8%);
+  backdrop-filter: blur(14px);
+}
+
+.learning-brand {
+  display: flex;
+  min-width: 0;
+  gap: 10px;
+  align-items: center;
+}
+
+.learning-brand-mark {
+  display: grid;
+  width: 34px;
+  height: 34px;
+  flex: 0 0 auto;
+  place-items: center;
+  color: #fff;
+  font-size: 12px;
+  font-weight: 800;
+  letter-spacing: 0.04em;
+  background: linear-gradient(135deg, #2563eb, #7c3aed);
+  border-radius: 10px;
+  box-shadow: 0 6px 18px rgb(79 70 229 / 24%);
+}
+
+.learning-brand div {
+  display: grid;
+  min-width: 0;
+  gap: 1px;
+}
+
+.learning-brand strong {
+  font-size: 15px;
+  line-height: 1.25;
+}
+
