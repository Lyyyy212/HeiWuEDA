+export async function ensureCowartCanvasState(args = {}) {
+  const loaded = await loadStoredCanvasSnapshot(args);
+  if (loaded.snapshot) return { created: false, snapshot: loaded.snapshot, storage: loaded.storage };
+
+  const { createTLStore } = await import("tldraw");
+  const store = createTLStore();
+  store.put([{
+    id: "page:page",
+    typeName: "page",
+    name: "Page 1",
+    index: "a1",
+    meta: {},
+  }]);
+  const snapshot = store.getStoreSnapshot();
+  const result = await saveStoredCanvasSnapshot(args, snapshot);
+  return { created: true, snapshot, ...result };
+}
+
 export async function saveCowartCanvasSnapshot(args = {}, snapshot) {
   const { sanitizeCanvasSnapshotForTldraw } = await import("../../src/canvasSnapshot.js");
   const sanitized = sanitizeCanvasSnapshotForTldraw(snapshot);
